{
  "name": "kollectyve-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Kollectyve chain SDK \u2014 Substrate (PAPI) + EVM (viem), with React bindings.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/pilot"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "codegen:substrate": "cd packages/substrate && npx papi add kollectyve -w ${KOLLECTYVE_WS:-ws://127.0.0.1:9944} && cd ../.. && node scripts/sync-descriptors.mjs",
    "smoke": "node scripts/smoke.mjs",
    "publish:dry": "node scripts/publish.mjs",
    "publish:all": "node scripts/publish.mjs --yes",
    "version:set": "node scripts/version.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@polkadot-labs/hdkd": "^0.0.10",
    "@polkadot-labs/hdkd-helpers": "^0.0.10"
  },
  "engines": {
    "node": ">=20"
  }
}
