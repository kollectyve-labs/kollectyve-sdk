{
  "name": "@kollectyve/credentials",
  "version": "0.1.0-alpha.2",
  "description": "Kollectyve credentials — canonical digests, a pre-rotating key ring, holder presentations and chain-walking verification. The engine behind the wallet.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kollectyve/core": "0.1.0-alpha.2",
    "@noble/hashes": "^1.5.0",
    "@polkadot-labs/hdkd": "^0.0.10",
    "@polkadot-labs/hdkd-helpers": "^0.0.10",
    "micro-sr25519": "^0.1.0"
  },
  "license": "MIT",
  "author": "Kollectyve Labs",
  "homepage": "https://github.com/kollectyve-labs/kollectyve-sdk#readme",
  "bugs": {
    "url": "https://github.com/kollectyve-labs/kollectyve-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kollectyve-labs/kollectyve-sdk.git",
    "directory": "packages/credentials"
  },
  "keywords": [
    "kollectyve",
    "verifiable-credentials",
    "did",
    "wallet",
    "pre-rotation"
  ],
  "publishConfig": {
    "access": "public"
  }
