{
  "name": "@kollectyve/substrate",
  "version": "0.1.0-alpha.2",
  "description": "Kollectyve SDK — Substrate side (pallets) built on polkadot-api (PAPI).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kollectyve/core": "0.1.0-alpha.2",
    "polkadot-api": "^1.7.0",
    "@polkadot-labs/hdkd": "^0.0.10",
    "@polkadot-labs/hdkd-helpers": "^0.0.10",
    "@kollectyve/chain-descriptors": "0.1.0-alpha.2"
  },
  "license": "MIT",
  "author": "Kollectyve Labs",
  "homepage": "https://github.com/kollectyve-labs/kollectyve-sdk#readme",
  "bugs": {
    "url": "https://github.com/kollectyve-labs/kollectyve-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kollectyve-labs/kollectyve-sdk.git",
    "directory": "packages/substrate"
  },
  "keywords": [
    "kollectyve",
    "substrate",
    "polkadot-api",
    "papi",
    "identity",
    "kyc"
  ],
  "publishConfig": {
    "access": "public"
  }
}
